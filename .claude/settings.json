{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      ".env*",
      "**/*.env",
      "**/secrets/**",
      "**/*secret*",
      "**/*password*",
      "**/*credential*",
      "git push --force",
      "git reset --hard",
      "git clean -f",
      "rm -rf /"
    ],
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "mcp__claude_ai_Notion__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Drive__*",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin*)"
    ]
  },
  "includeGitInstructions": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/SessionStart.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/PreToolUse.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/PostToolUse.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/Stop.ps1"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/log-subagent-spawn.ps1"
          }
        ]
      }
    ]
  }
}
